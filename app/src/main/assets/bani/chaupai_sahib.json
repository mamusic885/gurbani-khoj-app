{
  "title": "Chaupai Sahib",
  "verses": [
    {
      "id": 0,
      "line": "ੴ ਸ੍ਰੀ ਵਾਹਿਗੁਰੂ ਜੀ ਕੀ ਫਤਹ ॥"
    },
    {
      "id": 1,
      "line": "ਪਾਤਿਸ਼ਾਹੀ ੧੦॥"
    },
    {
      "id": 2,
      "line": "ਕਬਿਯੋ ਬਾਚ ਬੇਨਤੀ॥ ਚੌਪਈ ॥"
    },
    {
      "id": 3,
      "line": "ਹਮਰੀ ਕਰੋ ਹਾਥ ਦੈ ਰੱਛਾ ॥"
    },
    {
      "id": 4,
      "line": "ਪੂਰਨ ਹੋਇ ਚਿਤ ਕੀ ਇੱਛਾ ॥"
    },
    {
      "id": 5,
      "line": "ਤਵ ਚਰਨਨ ਮਨ ਰਹੈ ਹਮਾਰਾ ॥"
    },
    {
      "id": 6,
      "line": "ਅਪਨਾ ਜਾਨ ਕਰੋ ਪ੍ਰਤਿਪਾਰਾ ॥੧॥"
    },
    {
      "id": 7,
      "line": "ਹਮਰੇ ਦੁਸਟ ਸਭੈ ਤੁਮ ਘਾਵਹੁ ॥"
    },
    {
      "id": 8,
      "line": "ਆਪੁ ਹਾਥ ਦੈ ਮੋਹਿ ਬਚਾਵਹੁ ॥"
    },
    {
      "id": 9,
      "line": "ਸੁਖੀ ਬਸੈ ਮੋਰੋ ਪਰਿਵਾਰਾ ॥"
    },
    {
      "id": 10,
      "line": "ਸੇਵਕ ਸਿਖ੍ਯ ਸਭੈ ਕਰਤਾਰਾ ॥੨॥"
    },
    {
      "id": 11,
      "line": "ਮੋ ਰੱਛਾ ਨਿਜੁ ਕਰਿ ਦੈ ਕਰਿਯੈ ॥"
    },
    {
      "id": 12,
      "line": "ਸਭ ਬੈਰਨ ਕਉ ਆਜ ਸੰਘਰਿਯੈ ॥"
    },
    {
      "id": 13,
      "line": "ਪੂਰਨ ਹੋਇ ਹਮਾਰੀ ਆਸਾ ॥"
    },
    {
      "id": 14,
      "line": "ਤੋਰਿ ਭਜਨ ਕੀ ਰਹੈ ਪਿਯਾਸਾ ॥੩॥"
    },
    {
      "id": 15,
      "line": "ਤੁਮਹਿ ਛਾਡਿ ਕੋਈ ਅਵਰ ਨ ਧਿਯਾਊਂ ॥"
    },
    {
      "id": 16,
      "line": "ਜੋ ਬਰ ਚਾਹੌਂ ਸੁ ਤੁਮ ਤੇ ਪਾਊਂ ॥"
    },
    {
      "id": 17,
      "line": "ਸੇਵਕ ਸਿੱਖ੍ਯ ਹਮਾਰੇ ਤਾਰੀਅਹਿ ॥"
    },
    {
      "id": 18,
      "line": "ਚੁਨਿ ਚੁਨਿ ਸਤ੍ਰ ਹਮਾਰੇ ਮਾਰੀਅਹਿ ॥੪॥"
    },
    {
      "id": 19,
      "line": "ਆਪੁ ਹਾਥ ਦੈ ਮੁਝੈ ਉਬਰਿਯੈ ॥"
    },
    {
      "id": 20,
      "line": "ਮਰਨ ਕਾਲ ਕਾ ਤ੍ਰਾਸ ਨਿਵਰਿਯੈ ॥"
    },
    {
      "id": 21,
      "line": "ਹੂਜੋ ਸਦਾ ਹਮਾਰੇ ਪੱਛਾ ॥"
    },
    {
      "id": 22,
      "line": "ਸ੍ਰੀ ਅਸਿਧੁਜ ਜੂ ਕਰਿਯਹੁ ਰੱਛਾ ॥੫॥"
    },
    {
      "id": 23,
      "line": "ਰਾਖਿ ਲੇਹੁ ਮੁਹਿ ਰਾਖਨਹਾਰੇ ॥"
    },
    {
      "id": 24,
      "line": "ਸਾਹਿਬ ਸੰਤ ਸਹਾਇ ਪਿਯਾਰੇ ॥"
    },
    {
      "id": 25,
      "line": "ਦੀਨ ਬੰਧੁ ਦੁਸਟਨ ਕੇ ਹੰਤਾ ॥"
    },
    {
      "id": 26,
      "line": "ਤੁਮ ਹੋ ਪੁਰੀ ਚਤੁਰਦਸ ਕੰਤਾ ॥੬॥"
    },
    {
      "id": 27,
      "line": "ਕਾਲ ਪਾਇ ਬ੍ਰਹਮਾ ਬਪੁ ਧਰਾ ॥"
    },
    {
      "id": 28,
      "line": "ਕਾਲ ਪਾਇ ਸਿਵਜੂ ਅਵਤਰਾ ॥"
    },
    {
      "id": 29,
      "line": "ਕਾਲ ਪਾਇ ਕਰ ਬਿਸਨ ਪ੍ਰਕਾਸਾ ॥"
    },
    {
      "id": 30,
      "line": "ਸਕਲ ਕਾਲ ਕਾ ਕੀਆ ਤਮਾਸਾ ॥੭॥"
    },
    {
      "id": 31,
      "line": "ਜਵਨ ਕਾਲ ਜੋਗੀ ਸਿਵ ਕੀਓ ॥"
    },
    {
      "id": 32,
      "line": "ਬੇਦ ਰਾਜ ਬ੍ਰਹਮਾ ਜੂ ਥੀਓ ॥"
    },
    {
      "id": 33,
      "line": "ਜਵਨ ਕਾਲ ਸਭ ਲੋਕ ਸਵਾਰਾ ॥"
    },
    {
      "id": 34,
      "line": "ਨਮਸਕਾਰ ਹੈ ਤਾਹਿ ਹਮਾਰਾ ॥੮॥"
    },
    {
      "id": 35,
      "line": "ਜਵਨ ਕਾਲ ਸਭ ਜਗਤ ਬਨਾਯੋ ॥"
    },
    {
      "id": 36,
      "line": "ਦੇਵ ਦੈਤ ਜੱਛਨ ਉਪਜਾਯੋ ॥"
    },
    {
      "id": 37,
      "line": "ਆਦਿ ਅੰਤਿ ਏਕੈ ਅਵਤਾਰਾ ॥"
    },
    {
      "id": 38,
      "line": "ਸੋਈ ਗੁਰੂ ਸਮਝਿਯਹੁ ਹਮਾਰਾ ॥੯॥"
    },
    {
      "id": 39,
      "line": "ਨਮਸਕਾਰ ਤਿਸਹੀ ਕੋ ਹਮਾਰੀ ॥"
    },
    {
      "id": 40,
      "line": "ਸਕਲ ਪ੍ਰਜਾ ਜਿਨ ਆਪ ਸਵਾਰੀ ॥"
    },
    {
      "id": 41,
      "line": "ਸਿਵਕਨ ਕੋ ਸਵਗੁਨ ਸੁਖ ਦੀਓ ॥"
    },
    {
      "id": 42,
      "line": "ਸੱਤ੍ਰੁਨ ਕੋ ਪਲ ਮੋ ਬਧ ਕੀਓ ॥੧੦॥"
    },
    {
      "id": 43,
      "line": "ਘਟ ਘਟ ਕੇ ਅੰਤਰ ਕੀ ਜਾਨਤ ॥"
    },
    {
      "id": 44,
      "line": "ਭਲੇ ਬੁਰੇ ਕੀ ਪੀਰ ਪਛਾਨਤ ॥"
    },
    {
      "id": 45,
      "line": "ਚੀਟੀ ਤੇ ਕੁੰਚਰ ਅਸਥੂਲਾ ॥"
    },
    {
      "id": 46,
      "line": "ਸਭ ਪਰ ਕ੍ਰਿਪਾ ਦ੍ਰਿਸਟਿ ਕਰ ਫੂਲਾ ॥੧੧॥"
    },
    {
      "id": 47,
      "line": "ਸੰਤਨ ਦੁਖ ਪਾਏ ਤੇ ਦੁਖੀ ॥"
    },
    {
      "id": 48,
      "line": "ਸੁਖ ਪਾਏ ਸਾਧਨ ਕੇ ਸੁਖੀ ॥"
    },
    {
      "id": 49,
      "line": "ਏਕ ਏਕ ਕੀ ਪੀਰ ਪਛਾਨੈ ॥"
    },
    {
      "id": 50,
      "line": "ਘਟ ਘਟ ਕੇ ਪਟ ਪਟ ਕੀ ਜਾਨੈ ॥੧੨॥"
    },
    {
      "id": 51,
      "line": "ਜਬ ਉਦਕਰਖ ਕਰਾ ਕਰਤਾਰਾ ॥"
    },
    {
      "id": 52,
      "line": "ਪ੍ਰਜਾ ਧਰਤ ਤਬ ਦੇਹ ਅਪਾਰਾ ॥"
    },
    {
      "id": 53,
      "line": "ਜਬ ਆਕਰਖ ਕਰਤ ਹੋ ਕਬਹੂੰ ॥"
    },
    {
      "id": 54,
      "line": "ਤੁਮ ਮੈਂ ਮਿਲਤ ਦੇਹ ਧਰ ਸਭਹੂੰ ॥੧੩॥"
    },
    {
      "id": 55,
      "line": "ਜੇਤੇ ਬਦਨ ਸ੍ਰਿਸਟਿ ਸਭ ਧਾਰੈ ॥"
    },
    {
      "id": 56,
      "line": "ਆਪੁ ਆਪਨੀ ਬੂਝਿ ਉਚਾਰੈ ॥"
    },
    {
      "id": 57,
      "line": "ਤੁਮ ਸਭ ਹੀ ਤੇ ਰਹਤ ਨਿਰਾਲਮ ॥"
    },
    {
      "id": 58,
      "line": "ਜਾਨਤ ਬੇਦ ਭੇਦ ਅਰੁ ਆਲਮ ॥੧੪॥"
    },
    {
      "id": 59,
      "line": "ਨਿਰੰਕਾਰ ਨ੍ਰਿਬਿਕਾਰ ਨਿਰਲμਭ ॥"
    },
    {
      "id": 60,
      "line": "ਆਦਿ ਅਨੀਲ ਅਨਾਦਿ ਅਸੰਭ ॥"
    },
    {
      "id": 61,
      "line": "ਤਾ ਕਾ ਮੂੜ੍ਹ ਉਚਾਰਤ ਭੇਦਾ ॥"
    },
    {
      "id": 62,
      "line": "ਜਾ ਕੋ ਭੇਵ ਨ ਪਾਵਤ ਬੇਦਾ ॥੧੫॥"
    },
    {
      "id": 63,
      "line": "ਤਾ ਕੌ ਕਰਿ ਪਾਹਨ ਅਨੁਮਾਨਤ ॥"
    },
    {
      "id": 64,
      "line": "ਮਹਾ ਮੂੜ੍ਹ ਕਛੁ ਭੇਦ ਨ ਜਾਨਤ ॥"
    },
    {
      "id": 65,
      "line": "ਮਹਾਂਦੇਵ ਕੌ ਕਹਤ ਸਦਾ ਸਿਵ ॥"
    },
    {
      "id": 66,
      "line": "ਨਿਰੰਕਾਰ ਕਾ ਚੀਨਤ ਨਹਿ ਭਿਵ ॥੧੬॥"
    },
    {
      "id": 67,
      "line": "ਆਪੁ ਆਪੁਨੀ ਬੁਧਿ ਹੈ ਜੇਤੀ ॥"
    },
    {
      "id": 68,
      "line": "ਬਰਨਤ ਭਿੰਨ ਭਿੰਨ ਤੁਹਿ ਤੇਤੀ ॥"
    },
    {
      "id": 69,
      "line": "ਤੁਮਰਾ ਲਖਾ ਨ ਜਾਇ ਪਸਾਰਾ ॥"
    },
    {
      "id": 70,
      "line": "ਕਿਹ ਬਿਧਿ ਸਜਾ ਪ੍ਰਥਮ ਸੰਸਾਰਾ ॥੧੭॥"
    },
    {
      "id": 71,
      "line": "ਏਕੈ ਰੂਪ ਅਨੂਪ ਸਰੂਪਾ ॥"
    },
    {
      "id": 72,
      "line": "ਰੰਕ ਭਯੋ ਰਾਵ ਕਹੀ ਭੂਪਾ ॥"
    },
    {
      "id": 73,
      "line": "ਅੰਡਜ ਜੇਰਜ ਸੇਤਜ ਕੀਨੀ ॥"
    },
    {
      "id": 74,
      "line": "ਉਤਭੁਜ ਖਾਨਿ ਬਹੁਰਿ ਰਚਿ ਦੀਨੀ ॥੧੮॥"
    },
    {
      "id": 75,
      "line": "ਕਹੂੰ ਫੂਲਿ ਰਾਜਾ ਹ੍ਵੈ ਬੈਠਾ ॥"
    },
    {
      "id": 76,
      "line": "ਕਹੂੰ ਸਿਮਟਿ ਭਯੋ ਸੰਕਰ ਇਕੈਠਾ ॥"
    },
    {
      "id": 77,
      "line": "ਸਿਗਰੀ ਸ੍ਰਿਸਟਿ ਦਿਖਾਇ ਅਚੰਭਵ ॥"
    },
    {
      "id": 78,
      "line": "ਆਦਿ ਜੁਗਾਦਿ ਸਰੂਪ ਸੁਯੰਭਵ ॥੧੯॥"
    },
    {
      "id": 79,
      "line": "ਅਬ ਰੱਛਾ ਮੇਰੀ ਤੁਮ ਕਰੋ ॥"
    },
    {
      "id": 80,
      "line": "ਸਿੱਖ੍ਯ ਉਬਾਰਿ ਅਸਿੱਖ੍ਯ ਸੰਘਰੋ ॥"
    },
    {
      "id": 81,
      "line": "ਦੁਸਟ ਜਿਤੇ ਉਠਵਤ ਉਤਪਾਤਾ ॥"
    },
    {
      "id": 82,
      "line": "ਸਕਲ ਮਲੇਛ ਕਰੋ ਰਣ ਘਾਤਾ ॥੨੦॥"
    },
    {
      "id": 83,
      "line": "ਜੇ ਅਸਿਧੁਜ ਤਵ ਸਰਨੀ ਪਰੇ ॥"
    },
    {
      "id": 84,
      "line": "ਤਿਨ ਕੇ ਦੁਸਟ ਦੁਖਿਤ ਹ੍ਵੈ ਮਰੇ ॥"
    },
    {
      "id": 85,
      "line": "ਪੁਰਖ ਜਵਨ ਪਗ ਪਰੇ ਤਿਹਾਰੇ ॥"
    },
    {
      "id": 86,
      "line": "ਤਿਨ ਕੇ ਤੁਮ ਸੰਕਟ ਸਭ ਟਾਰੇ ॥੨੧॥"
    },
    {
      "id": 87,
      "line": "ਜੋ ਕਲਿ ਕੋ ਇਕ ਬਾਰ ਧਿਐਹੈ ॥"
    },
    {
      "id": 88,
      "line": "ਤਾ ਕੇ ਕਾਲ ਨਿਕਟਿ ਨਹਿ ਐਹੈ ॥"
    },
    {
      "id": 89,
      "line": "ਰੱਛਾ ਹੋਇ ਤਾਹਿ ਸਭ ਕਾਲਾ ॥"
    },
    {
      "id": 90,
      "line": "ਦੁਸਟ ਅਰਿਸਟ ਟਰੈੇਂ ਤਤਕਾਲਾ ॥੨੨॥"
    },
    {
      "id": 91,
      "line": "ਕ੍ਰਿਪਾ ਦ੍ਰਿਸਟਿ ਤਨ ਜਾਹਿ ਨਿਹਰਿਹੋ ॥"
    },
    {
      "id": 92,
      "line": "ਤਾ ਕੇ ਤਾਪ ਤਨਕ ਮਹਿ ਹਰਿਹੋ ॥"
    },
    {
      "id": 93,
      "line": "ਰਿੱਧਿ ਸਿੱਧਿ ਘਰ ਮੋ ਸਭ ਹੋਈ ॥"
    },
    {
      "id": 94,
      "line": "ਦੁਸਟ ਛਾਹ ਛ੍ਵੈ ਸਕੈ ਨ ਕੋਈ ॥੨੩॥"
    },
    {
      "id": 95,
      "line": "ਏਕ ਬਾਰ ਜਿਨ ਤੁਮੈ ਸੰਭਾਰਾ ॥"
    },
    {
      "id": 96,
      "line": "ਕਾਲ ਫਾਸ ਤੇ ਤਾਹਿ ਉਬਾਰਾ ॥"
    },
    {
      "id": 97,
      "line": "ਜਿਨ ਨਰ ਨਾਮ ਤਿਹਾਰੋ ਕਹਾ ॥"
    },
    {
      "id": 98,
      "line": "ਦਾਰਿਦ ਦੁਸਟ ਦੋਖ ਤੇ ਰਹਾ ॥੨੪॥"
    },
    {
      "id": 99,
      "line": "ਖੜਗਕੇਤ ਮੈ ਸਰਣਿ ਤਿਹਾਰੀ ॥"
    },
    {
      "id": 100,
      "line": "ਆਪੁ ਹਾਥ ਦੈ ਲੇਹੁ ਉਬਾਰੀ ॥"
    },
    {
      "id": 101,
      "line": "ਸਰਬ ਠੌਰ ਮੋ ਹੋਹੁ ਸਹਾਈ ॥"
    },
    {
      "id": 102,
      "line": "ਦੁਸਟ ਦੋਖ ਤੇ ਲੇਹੁ ਬਚਾਈ ॥੨੫॥"
    },
    {
      "id": 103,
      "line": "ਕ੍ਰਿਪਾ ਕਰੀ ਹਮ ਪਰ ਜਗ ਮਾਤਾ ॥"
    },
    {
      "id": 104,
      "line": "ਗ੍ਰੰਥ ਕਰਾ ਪੂਰਨ ਸੁਭ ਰਾਤਾ ॥"
    },
    {
      "id": 105,
      "line": "ਕਿਲਬਿਖ ਸਕਲ ਦੇਹ ਕੋ ਹਰਤਾ ॥"
    },
    {
      "id": 106,
      "line": "ਦੁਸਟ ਦੋਖਿਯਨ ਕੋ ਛੈ ਕਰਤਾ ॥੨੬॥"
    },
    {
      "id": 107,
      "line": "ਸ੍ਰੀ ਅਸਿਧੁਜ ਜਬ ਭਏ ਦਇਆਲਾ ॥"
    },
    {
      "id": 108,
      "line": "ਪੂਰਨ ਕਰਾ ਗ੍ਰੰਥ ਤਤਕਾਲਾ ॥"
    },
    {
      "id": 109,
      "line": "ਮਨ ਬਾਂਛਤ ਫਲ ਪਾਵੈ ਸੋਈ ॥"
    },
    {
      "id": 110,
      "line": "ਦੂਖ ਨ ਤਿਸੈ ਬਿਆਪਤ ਕੋਈ ॥੨੭॥"
    },
    {
      "id": 111,
      "line": "ਅੜਿੱਲ ॥"
    },
    {
      "id": 112,
      "line": "ਸੁਨੈ ਗੁੰਗ ਜੋ ਯਾਹਿ ਸੁ ਰਸਨਾ ਪਾਵਈ ॥"
    },
    {
      "id": 113,
      "line": "ਸੁਨੈ ਮੂੜ ਚਿਤ ਲਾਇ ਚਤੁਰਤਾ ਆਵਈ॥"
    },
    {
      "id": 114,
      "line": "ਦੂਖ ਦਰਦ ਭੌ ਨਿਕਟ ਨ ਤਿਨ ਨਰ ਕੇ ਰਹੈ ॥"
    },
    {
      "id": 115,
      "line": "ਹੋ ਜੋ ਯਾਕੀ ਏਕ ਬਾਰ ਚੌਪਈ ਕੋ ਕਹੈ"
    },
    {
      "id": 116,
      "line": "॥੨੮॥"
    },
    {
      "id": 117,
      "line": "ਚੌਪਈ॥"
    },
    {
      "id": 118,
      "line": "ਸੰਬਤ ਸੱਤ੍ਰਹ ਸਹਸ ਭਣਿੱਜੈ॥"
    },
    {
      "id": 119,
      "line": "ਅਰਧ ਸਹਸ ਫੁਨਿ ਤੀਨਿ ਕਹਿੱਜੈ॥"
    },
    {
      "id": 120,
      "line": "ਭਾਦ੍ਰਵ ਸੁਦੀ ਅਸਟਮੀ ਰਵਿਵਾਰਾ॥"
    },
    {
      "id": 121,
      "line": "ਤੀਰ ਸਤੁੱਧ੍ਰਵ ਗ੍ਰੰਥ ਸੁਧਾਰਾ ॥੨੯॥"
    },
    {
      "id": 122,
      "line": "ਸ੍ਵੈਯਾ ॥"
    },
    {
      "id": 123,
      "line": "ਪਾਂਇ ਗਹੇ ਜਬ ਤੇ ਤੁਮਰੇ ਤਬ ਤੇ ਕੋਊ ਆਂਖ"
    },
    {
      "id": 124,
      "line": "ਤਰੇ ਨਹੀ ਆਨ੍ਯੋ ॥"
    },
    {
      "id": 125,
      "line": "ਰਾਮ ਰਹੀਮ ਪੁਰਾਨ ਕੁਰਾਨ ਅਨੇਕ ਕਹੈਂ"
    },
    {
      "id": 126,
      "line": "ਮਤ ਏਕ ਨ ਮਾਨ੍ਯੋ ॥"
    },
    {
      "id": 127,
      "line": "ਸਿੰਮ੍ਰਿਤਿ ਸਾਸਤ੍ਰ ਬੇਦ ਸਭੈ ਬਹੁ ਭੇਦ ਕਹੈਂ ਹਮ"
    },
    {
      "id": 128,
      "line": "ਏਕ ਨ ਜਾਨ੍ਯੋ ॥"
    },
    {
      "id": 129,
      "line": "ਸ੍ਰੀ ਅਸਿਪਾਨ ਕ੍ਰਿਪਾ ਤੁਮਰੀ ਕਰਿ ਮੈ ਨ"
    },
    {
      "id": 130,
      "line": "ਕਹ੍ਯੋ ਸਭ ਤੋਹਿ ਬਖਾਨ੍ਯੋ ॥"
    },
