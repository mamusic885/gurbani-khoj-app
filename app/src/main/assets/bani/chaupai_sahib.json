{
  "title": "ਚੌਪਈ ਸਾਹਿਬ",
  "verses": [
    {
      "id": 1524,
      "line": "ਦੋਹਰਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1525,
      "line": "ਮਹਾ ਕਾਲ ਕੀ ਸਰਨਿ ਜੇ ਪਰੇ ਸੁ ਲਏ ਬਚਾਇ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1526,
      "line": "ਔਰ ਨ ਉਪਜਾ ਦੂਸਰ ਜਗ ਭਛਿਯੋ ਸਭੈ ਬਨਾਇ ॥੩੬੬॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1527,
      "line": "ਜੋ ਪੂਜਾ ਅਸਿਕੇਤੁ ਕੀ ਨਿਤ ਪ੍ਰਤਿ ਕਰੈ ਬਨਾਇ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1528,
      "line": "ਤਿਨ ਪਰ ਅਪਨੋ ਹਾਥ ਦੈ ਅਸਿਧੁਜ ਲੇਤ ਬਚਾਇ ॥੩੬੭॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1529,
      "line": "ਚੌਪਈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1530,
      "line": "ਦੁਸਟ ਦੈਤ ਕਛੁ ਬਾਤ ਨ ਜਾਨੀ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1531,
      "line": "ਮਹਾ ਕਾਲ ਤਨ ਪੁਨਿ ਰਿਸਿ ਠਾਨੀ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1532,
      "line": "ਬਲ ਅਪਬਲ ਅਪਨੋ ਨ ਬਿਚਾਰਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1533,
      "line": "ਗਰਬ ਠਾਨਿ ਜਿਯ ਬਹੁਰਿ ਹੰਕਾਰਾ ॥੩੬੮॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1534,
      "line": "ਰੇ ਰੇ ਕਾਲ ਫੂਲਿ ਜਿਨਿ ਜਾਹੁ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1535,
      "line": "ਬਹੁਰਿ ਆਨਿ ਸੰਗ੍ਰਾਮ ਮਚਾਹੁ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1536,
      "line": "ਏਕ ਨਿਦਾਨ ਕਰੋ ਰਨ ਮਾਹੀ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1537,
      "line": "ਕੈ ਅਸਿਧੁਜਿ ਕੈ ਦਾਨਵ ਨਾਹੀ ॥੩੬੯॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1538,
      "line": "ਏਕ ਪਾਵ ਤਜਿ ਜੁਧ ਨ ਭਾਜਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1539,
      "line": "ਮਹਾਰਾਜ ਦੈਤਨ ਕਾ ਰਾਜਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1540,
      "line": "ਆਂਤੌ ਗੀਧ ਗਗਨ ਲੈ ਗਏ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1541,
      "line": "ਬਾਹਤ ਬਿਸਿਖ ਤਊ ਹਠ ਭਏ ॥੩੭੦॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1542,
      "line": "ਅਸੁਰ ਅਮਿਤ ਰਨ ਬਾਨ ਚਲਾਏ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1543,
      "line": "ਨਿਰਖਿ ਖੜਗਧੁਜ ਕਾਟਿ ਗਿਰਾਏ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1544,
      "line": "ਬੀਸ ਸਹਸ੍ਰ ਅਸੁਰ ਪਰ ਬਾਨਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1545,
      "line": "ਸ੍ਰੀ ਅਸਿਧੁਜ ਛਾਡੇ ਬਿਧਿ ਨਾਨਾ ॥੩੭੧॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1546,
      "line": "ਮਹਾ ਕਾਲ ਪੁਨਿ ਜਿਯ ਮੈ ਕੋਪਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1547,
      "line": "ਧਨੁਖ ਟੰਕੋਰ ਬਹੁਰਿ ਰਨ ਰੋਪਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1548,
      "line": "ਏਕ ਬਾਨ ਤੇ ਧੁਜਹਿ ਗਿਰਾਯੋ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1549,
      "line": "ਦੁਤਿਯ ਸਤ੍ਰੁ ਕੋ ਸੀਸ ਉਡਾਯੋ ॥੩੭੨॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1550,
      "line": "ਦੁਹੂੰ ਬਿਸਿਖ ਕਰਿ ਦ੍ਵੈ ਰਥ ਚਕ੍ਰ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1551,
      "line": "ਕਾਟਿ ਦਏ ਛਿਨ ਇਕ ਮੈ ਬਕ੍ਰ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1552,
      "line": "ਚਾਰਹਿ ਬਾਨ ਚਾਰ ਹੂੰ ਬਾਜਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1553,
      "line": "ਮਾਰ ਦਏ ਸਭ ਜਗ ਕੇ ਰਾਜਾ ॥੩੭੩॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1554,
      "line": "ਬਹੁਰਿ ਅਸੁਰ ਕਾ ਕਾਟਸਿ ਮਾਥਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1555,
      "line": "ਸ੍ਰੀ ਅਸਿਕੇਤਿ ਜਗਤ ਕੇ ਨਾਥਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1556,
      "line": "ਦੁਤਿਯ ਬਾਨ ਸੌ ਦੋਊ ਅਰਿ ਕਰ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1557,
      "line": "ਕਾਟਿ ਦਯੋ ਅਸਿਧੁਜ ਨਰ ਨਾਹਰ ॥੩੭੪॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1558,
      "line": "ਪੁਨਿ ਰਾਛਸ ਕਾ ਕਾਟਾ ਸੀਸਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1559,
      "line": "ਸ੍ਰੀ ਅਸਿਕੇਤੁ ਜਗਤ ਕੇ ਈਸਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1560,
      "line": "ਪੁਹਪਨ ਬ੍ਰਿਸਟਿ ਗਗਨ ਤੇ ਭਈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1561,
      "line": "ਸਭਹਿਨ ਆਨਿ ਬਧਾਈ ਦਈ ॥੩੭੫॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1562,
      "line": "ਧੰਨ੍ਯ ਧੰਨ੍ਯ ਲੋਗਨ ਕੇ ਰਾਜਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1563,
      "line": "ਦੁਸਟਨ ਦਾਹ ਗਰੀਬ ਨਿਵਾਜਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1564,
      "line": "ਅਖਲ ਭਵਨ ਕੇ ਸਿਰਜਨਹਾਰੇ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1565,
      "line": "ਦਾਸ ਜਾਨਿ ਮੁਹਿ ਲੇਹੁ ਉਬਾਰੇ ॥੩੭੬॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1566,
      "line": "ੴ ਸ੍ਰੀ ਵਾਹਿਗੁਰੂ ਜੀ ਕੀ ਫਤਹ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "There is one god, Waheguroo, Victory is his."
    },
    {
      "id": 1567,
      "line": "ਪਾਤਿਸ਼ਾਹੀ ੧੦ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Written by the Sovereign King, Guru Gobind Singh Ji"
    },
    {
      "id": 1568,
      "line": "ਕਬਿਯੋ ਬਾਚ ਬੇਨਤੀ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Speech of the poet."
    },
    {
      "id": 1569,
      "line": "ਚੌਪਈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Chaupai"
    },
    {
      "id": 1570,
      "line": "ਹਮਰੀ ਕਰੋ ਹਾਥ ਦੈ ਰੱਛਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Protect me O Lord! with Thine own Hands"
    },
    {
      "id": 1571,
      "line": "ਪੂਰਨ ਹੋਇ ਚਿਤ ਕੀ ਇੱਛਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "all the desires of my heart be fulfilled."
    },
    {
      "id": 1572,
      "line": "ਤਵ ਚਰਨਨ ਮਨ ਰਹੈ ਹਮਾਰਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Let my mind rest under Thy Feet"
    },
    {
      "id": 1573,
      "line": "ਅਪਨਾ ਜਾਨ ਕਰੋ ਪ੍ਰਤਿਪਾਰਾ ॥੩੭੭॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Sustain me, considering me Thine own.377."
    },
    {
      "id": 1574,
      "line": "ਹਮਰੇ ਦੁਸਟ ਸਭੈ ਤੁਮ ਘਾਵਹੁ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Destroy, O Lord! all my enemies and"
    },
    {
      "id": 1575,
      "line": "ਆਪੁ ਹਾਥ ਦੈ ਮੋਹਿ ਬਚਾਵਹੁ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "protect me with Thine won Hands."
    },
    {
      "id": 1576,
      "line": "ਸੁਖੀ ਬਸੈ ਮੋਰੋ ਪਰਿਵਾਰਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "May my family live in comfort"
    },
    {
      "id": 1577,
      "line": "ਸੇਵਕ ਸਿੱਖ ਸਭੈ ਕਰਤਾਰਾ ॥੩੭੮॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "and ease alongwith all my servants and disciples.378."
    },
    {
      "id": 1578,
      "line": "ਮੋ ਰੱਛਾ ਨਿਜ ਕਰ ਦੈ ਕਰਿਯੈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Protect me O Lord! with Thine own Hands"
    },
    {
      "id": 1579,
      "line": "ਸਭ ਬੈਰਨ ਕੋ ਆਜ ਸੰਘਰਿਯੈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "and destroy this day all my enemies"
    },
    {
      "id": 1580,
      "line": "ਪੂਰਨ ਹੋਇ ਹਮਾਰੀ ਆਸਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "May all the aspirations be fulfilled"
    },
    {
      "id": 1581,
      "line": "ਤੋਰ ਭਜਨ ਕੀ ਰਹੈ ਪਿਆਸਾ ॥੩੭੯॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Let my thirst for Thy Name remain afresh.379."
    },
    {
      "id": 1582,
      "line": "ਤੁਮਹਿ ਛਾਡਿ ਕੋਈ ਅਵਰ ਨ ਧਿਯਾਊਂ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "I may remember none else except Thee"
    },
    {
      "id": 1583,
      "line": "ਜੋ ਬਰ ਚਹੋਂ ਸੁ ਤੁਮ ਤੇ ਪਾਊਂ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "And obtain all the required boons from Thee"
    },
    {
      "id": 1584,
      "line": "ਸੇਵਕ ਸਿੱਖ ਹਮਾਰੇ ਤਾਰੀਅਹਿ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Let my servants and disciples cross the world-ocean"
    },
    {
      "id": 1585,
      "line": "ਚੁਨਿ ਚੁਨਿ ਸਤ੍ਰ ਹਮਾਰੇ ਮਾਰੀਅਹਿ ॥੩੮੦॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "All my enemies be singled out and killed.380."
    },
    {
      "id": 1586,
      "line": "ਆਪ ਹਾਥ ਦੈ ਮੁਝੈ ਉਬਰਿਯੈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Protect me O Lord! with Thine own Hands and"
    },
    {
      "id": 1587,
      "line": "ਮਰਨ ਕਾਲ ਕਾ ਤ੍ਰਾਸ ਨਿਵਰਿਯੈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "relieve me form the fear of death"
    },
    {
      "id": 1588,
      "line": "ਹੂਜੋ ਸਦਾ ਹਮਾਰੇ ਪੱਛਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "May Thou ever Bestow Thy favours on my side"
    },
    {
      "id": 1589,
      "line": "ਸ੍ਰੀ ਅਸਿਧੁਜ ਜੂ ਕਰਿਯਹੁ ਰੱਛਾ ॥੩੮੧॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Protect me O Lord! Thou, the Supreme Destroyer.381."
    },
    {
      "id": 1590,
      "line": "ਰਾਖਿ ਲੇਹੁ ਮੁਹਿ ਰਾਖਨਹਾਰੇ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Protect me, O Protector Lord!"
    },
    {
      "id": 1591,
      "line": "ਸਾਹਿਬ ਸੰਤ ਸਹਾਇ ਪਿਯਾਰੇ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Most dear, the Protector of the Saints:"
    },
    {
      "id": 1592,
      "line": "ਦੀਨ ਬੰਧੁ ਦੁਸਟਨ ਕੇ ਹੰਤਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Friend of poor and the Destroyer of the enemies"
    },
    {
      "id": 1593,
      "line": "ਤੁਮ ਹੋ ਪੁਰੀ ਚਤੁਰ ਦਸ ਕੰਤਾ ॥੩੮੨॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Thou art the Master of the fourteen worlds.382."
    },
    {
      "id": 1594,
      "line": "ਕਾਲ ਪਾਇ ਬ੍ਰਹਮਾ ਬਪੁ ਧਰਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "In due time Brahma appeared in physical form"
    },
    {
      "id": 1595,
      "line": "ਕਾਲ ਪਾਇ ਸਿਵਜੂ ਅਵਤਰਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "In due time Shiva incarnated"
    },
    {
      "id": 1596,
      "line": "ਕਾਲ ਪਾਇ ਕਰ ਬਿਸਨੁ ਪ੍ਰਕਾਸਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "In due time Vishnu manifested himself"
    },
    {
      "id": 1597,
      "line": "ਸਕਲ ਕਾਲ ਕਾ ਕੀਆ ਤਮਾਸਾ ॥੩੮੩॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "All this is the play of the Temporal Lord.383."
    },
    {
      "id": 1598,
      "line": "ਜਵਨ ਕਾਲ ਜੋਗੀ ਸਿਵ ਕੀਓ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "The Temporal Lord, who created Shiva, the Yogi"
    },
    {
      "id": 1599,
      "line": "ਬੇਦ ਰਾਜ ਬ੍ਰਹਮਾ ਜੂ ਥੀਓ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Who created Brahma, the Master of the Vedas"
    },
    {
      "id": 1600,
      "line": "ਜਵਨ ਕਾਲ ਸਭ ਲੋਕ ਸਵਾਰਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "The Temporal Lord who fashioned the entire world"
    },
    {
      "id": 1601,
      "line": "ਨਮਸਕਾਰ ਹੈ ਤਾਹਿ ਹਮਾਰਾ ॥੩੮੪॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "I salute the same Lord.384."
    },
    {
      "id": 1602,
      "line": "ਜਵਨ ਕਾਲ ਸਭ ਜਗਤ ਬਨਾਯੋ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "The Temporal Lord, who created the whole world"
    },
    {
      "id": 1603,
      "line": "ਦੇਵ ਦੈਤ ਜੱਛਨ ਉਪਜਾਯੋ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Who created gods, demons and yakshas"
    },
    {
      "id": 1604,
      "line": "ਆਦਿ ਅੰਤਿ ਏਕੈ ਅਵਤਾਰਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He is the only one form the beginning to the end"
    },
    {
      "id": 1605,
      "line": "ਸੋਈ ਗੁਰੂ ਸਮਝਿਯਹੁ ਹਮਾਰਾ ॥੩੮੫॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "I consider Him only my Guru.385."
    },
    {
      "id": 1606,
      "line": "ਨਮਸਕਾਰ ਤਿਸ ਹੀ ਕੋ ਹਮਾਰੀ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "I salute Him, non else, but Him"
    },
    {
      "id": 1607,
      "line": "ਸਕਲ ਪ੍ਰਜਾ ਜਿਨ ਆਪ ਸਵਾਰੀ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Who has created Himself and His subject"
    },
    {
      "id": 1608,
      "line": "ਸਿਵਕਨ ਕੋ ਸਿਵਗੁਨ ਸੁਖ ਦੀਓ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He bestows Divine virtues and happiness on His servants"
    },
    {
      "id": 1609,
      "line": "ਸਤੱ੍ਰੁਨ ਕੋ ਪਲ ਮੋ ਬਧ ਕੀਓ ॥੩੮੬॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He destroys the enemies instantly.386."
    },
    {
      "id": 1610,
      "line": "ਘਟ ਘਟ ਕੇ ਅੰਤਰ ਕੀ ਜਾਨਤ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He knows the inner feelings of every heart"
    },
    {
      "id": 1611,
      "line": "ਭਲੇ ਬੁਰੇ ਕੀ ਪੀਰ ਪਛਾਨਤ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He knows the anguish of both good and bad"
    },
    {
      "id": 1612,
      "line": "ਚੀਟੀ ਤੇ ਕੁੰਚਰ ਅਸਥੂਲਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "From the ant to the solid elephant"
    },
    {
      "id": 1613,
      "line": "ਸਭ ਪਰ ਕ੍ਰਿਪਾ ਦ੍ਰਿਸਟਿ ਕਰ ਫੂਲਾ ॥੩੮੭॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He casts His Graceful glance on all and feels pleased.387."
    },
    {
      "id": 1614,
      "line": "ਸੰਤਨ ਦੁਖ ਪਾਏ ਤੇ ਦੁਖੀ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He is painful, when He sees His saints in grief"
    },
    {
      "id": 1615,
      "line": "ਸੁਖ ਪਾਏ ਸਾਧੁਨ ਕੇ ਸੁਖੀ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He is happy, when His saints are happy."
    },
    {
      "id": 1616,
      "line": "ਏਕ ਏਕ ਕੀ ਪੀਰ ਪਛਾਨੈਂ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He knows the agony of everyone"
    },
    {
      "id": 1617,
      "line": "ਘਟ ਘਟ ਕੇ ਪਟ ਪਟ ਕੀ ਜਾਨੈਂ ॥੩੮੮॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He knows the innermost secrets of every heart.388."
    },
    {
      "id": 1618,
      "line": "ਜਬ ਉਦਕਰਖ ਕਰਾ ਕਰਤਾਰਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "When the Creator projected Himself,"
    },
    {
      "id": 1619,
      "line": "ਪ੍ਰਜਾ ਧਰਤ ਤਬ ਦੇਹ ਅਪਾਰਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "His creation manifested itself in innumerable forms"
    },
    {
      "id": 1620,
      "line": "ਜਬ ਆਕਰਖ ਕਰਤ ਹੋ ਕਬਹੂੰ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "When at any time He withdraws His creation,"
    },
    {
      "id": 1621,
      "line": "ਤੁਮ ਮੈ ਮਿਲਤ ਦੇਹ ਧਰ ਸਭਹੂੰ ॥੩੮੯॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "all the physical forms are merged in Him.389."
    },
    {
      "id": 1622,
      "line": "ਜੇਤੇ ਬਦਨ ਸ੍ਰਿਸਟਿ ਸਭ ਧਾਰੈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "All the bodies of living beings created in the world"
    },
    {
      "id": 1623,
      "line": "ਆਪੁ ਆਪਨੀ ਬੂਝ ਉਚਾਰੈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "speak about Him according to their understanding"
    },
    {
      "id": 1624,
      "line": "ਤੁਮ ਸਭਹੀ ਤੇ ਰਹਤ ਨਿਰਾਲਮ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "But Thou, O Lord! live quite apart from everything"
    },
    {
      "id": 1625,
      "line": "ਜਾਨਤ ਬੇਦ ਭੇਦ ਅਰ ਆਲਮ ॥੩੯੦॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "this fact is know to the Vedas and the learned.390."
    },
    {
      "id": 1626,
      "line": "ਨਿਰੰਕਾਰ ਨ੍ਰਿਬਿਕਾਰ ਨਿਰਲੰਭ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "The Lord is Formless, Sinless and shelterless:"
    },
    {
      "id": 1627,
      "line": "ਆਦਿ ਅਨੀਲ ਅਨਾਦਿ ਅਸੰਭ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He is the Primal Power, without Blemish, without Beginning and Unborn"
    },
    {
      "id": 1628,
      "line": "ਤਾਕਾ ਮੂੜ੍ਹ ਉਚਾਰਤ ਭੇਦਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "The fool claims boastfully about the knowledge of His secrets,"
    },
    {
      "id": 1629,
      "line": "ਜਾ ਕੋ ਭੇਵ ਨ ਪਾਵਤ ਬੇਦਾ ॥੩੯੧॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "which even the Vedas do not know.391."
    },
    {
      "id": 1630,
      "line": "ਤਾ ਕੋ ਕਰਿ ਪਾਹਨ ਅਨੁਮਾਨਤ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "The fool considers Him a stone,"
    },
    {
      "id": 1631,
      "line": "ਮਹਾ ਮੂੜ੍ਹ ਕਛੁ ਭੇਦ ਨ ਜਾਨਤ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "but the great fool does not know any secret"
    },
    {
      "id": 1632,
      "line": "ਮਹਾਦੇਵ ਕੋ ਕਹਤ ਸਦਾ ਸਿਵ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He calls Shiva “The Eternal Lord,"
    },
    {
      "id": 1633,
      "line": "ਨਿਰੰਕਾਰ ਕਾ ਚੀਨਤ ਨਹਿ ਭਿਵ ॥੩੯੨॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "“but he does not know the secret of the Formless Lord.392."
    },
    {
      "id": 1634,
      "line": "ਆਪੁ ਆਪਨੀ ਬੁਧਿ ਹੈ ਜੇਤੀ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "According to ones won intellect,"
    },
    {
      "id": 1635,
      "line": "ਬਰਨਤ ਭਿੰਨ ਭਿੰਨ ਤੁਹਿ ਤੇਤੀ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "one describes Thee differently"
    },
    {
      "id": 1636,
      "line": "ਤੁਮਰਾ ਲਖਾ ਨ ਜਾਇ ਪਸਾਰਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "The limits of Thy creation cannot be known"
    },
    {
      "id": 1637,
      "line": "ਕਿਹ ਬਿਧਿ ਸਜਾ ਪ੍ਰਥਮ ਸੰਸਾਰਾ ॥੩੯੩॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "and how the world was fashioned in the beginning?393."
    },
    {
      "id": 1638,
      "line": "ਏਕੈ ਰੂਪ ਅਨੂਪ ਸਰੂਪਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He hath only one unparalleled Form"
    },
    {
      "id": 1639,
      "line": "ਰੰਕ ਭਯੋ ਰਾਵ ਕਹੀ ਭੂਪਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He manifests Himself as a poor man or a king at different places"
    },
    {
      "id": 1640,
      "line": "ਅੰਡਜ ਜੇਰਜ ਸੇਤਜ ਕੀਨੀ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He created creatures from eggs, wombs and perspiration"
    },
    {
      "id": 1641,
      "line": "ਉਤਭੁਜ ਖਾਨਿ ਬਹੁਰ ਰਚਿ ਦੀਨੀ ॥੩੯੪॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Then He created the vegetable kingdom.394."
    },
    {
      "id": 1642,
      "line": "ਕਹੂੰ ਫੂਲ ਰਾਜਾ ਹ੍ਵੈ ਬੈਠਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Somewhere He sits joyfully as a king"
    },
    {
      "id": 1643,
      "line": "ਕਹੂੰ ਸਿਮਟਿ ਭ੍ਯਿੋ ਸੰਕਰ ਇਕੈਠਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Somewhere He contracts Himself as Shiva, the Yogi"
    },
    {
      "id": 1644,
      "line": "ਸਗਰੀ ਸ੍ਰਿਸਟਿ ਦਿਖਾਇ ਅਚੰਭਵ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "All His creation unfolds wonderful things"
    },
    {
      "id": 1645,
      "line": "ਆਦਿ ਜੁਗਾਦਿ ਸਰੂਪ ਸੁਯੰਭਵ ॥੩੯੫॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He, the Primal Power, is from the beginning and Self-Existent.395."
    },
    {
      "id": 1646,
      "line": "ਅਬ ਰੱਛਾ ਮੇਰੀ ਤੁਮ ਕਰੋ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "O Lord! keep me now under Thy protection"
    },
    {
      "id": 1647,
      "line": "ਸਿੱਖ ਉਬਾਰਿ ਅਸਿੱਖ ਸੰਘਰੋ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Protect my disciples and destroy my enemies"
    },
    {
      "id": 1648,
      "line": "ਦੁਸ਼ਟ ਜਿਤੇ ਉਠਵਤ ਉਤਪਾਤਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "All the villains creations outrage"
    },
    {
      "id": 1649,
      "line": "ਸਕਲ ਮਲੇਛ ਕਰੋ ਰਣ ਘਾਤਾ ॥੩੯੬॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "and all the infidels be destroyed in the battlefield.396."
    },
    {
      "id": 1650,
      "line": "ਜੇ ਅਸਿਧੁਜ ਤਵ ਸਰਨੀ ਪਰੇ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "O Supreme Destroyer! those who sought Thy refuge,"
    },
    {
      "id": 1651,
      "line": "ਤਿਨ ਕੇ ਦੁਸ਼ਟ ਦੁਖਿਤ ਹ੍ਵੈ ਮਰੇ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "their enemies met painful death"
    },
    {
      "id": 1652,
      "line": "ਪੁਰਖ ਜਵਨ ਪਗ ਪਰੇ ਤਿਹਾਰੇ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "The persons who fell at Thy Feet,"
    },
    {
      "id": 1653,
      "line": "ਤਿਨ ਕੇ ਤੁਮ ਸੰਕਟ ਸਭ ਟਾਰੇ ॥੩੯੭॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "thou didst remove all their troubles.397."
    },
    {
      "id": 1654,
      "line": "ਜੋ ਕਲਿ ਕੋ ਇਕ ਬਾਰ ਧਿਐ ਹੈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Those who meditate even on the Supreme Destroyer,"
    },
    {
      "id": 1655,
      "line": "ਤਾ ਕੇ ਕਾਲ ਨਿਕਟਿ ਨਹਿ ਐਹੈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "death cannot approach them."
    },
    {
      "id": 1656,
      "line": "ਰੱਛਾ ਹੋਇ ਤਾਹਿ ਸਭ ਕਾਲਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "They remain protected at all times"
    },
    {
      "id": 1657,
      "line": "ਦੁਸਟ ਅਰਿਸਟ ਟਰੇਂ ਤਤਕਾਲਾ ॥੩੯੮॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Their enemies and troubles come to and end instantly.398."
    },
    {
      "id": 1658,
      "line": "ਕ੍ਰਿਪਾ ਦ੍ਰਿਸਟਿ ਤਨ ਜਾਹਿ ਨਿਹਰਿਹੋ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Upon whomsoever Thou dost cast Thy favourable glance,"
    },
    {
      "id": 1659,
      "line": "ਤਾਕੇ ਤਾਪ ਤਨਕ ਮੋ ਹਰਿਹੋ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "they are absolved of sins instantly"
    },
    {
      "id": 1660,
      "line": "ਰਿੱਧਿ ਸਿੱਧਿ ਘਰ ਮੋ ਸਭ ਹੋਈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "They have all the worldly and spiritual pleasures in their homes"
    },
    {
      "id": 1661,
      "line": "ਦੁਸ਼ਟ ਛਾਹ ਛ੍ਵੈ ਸਕੈ ਨ ਕੋਈ ॥੩੯੯॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "None of their enemies can even touch their shadow.399."
    },
    {
      "id": 1662,
      "line": "ਏਕ ਬਾਰ ਜਿਨ ਤੁਮੈ ਸੰਭਾਰਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He, who remembered Thee even once,"
    },
    {
      "id": 1663,
      "line": "ਕਾਲ ਫਾਸ ਤੇ ਤਾਹਿ ਉਬਾਰਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "thou didst protect him from the noose of death"
    },
    {
      "id": 1664,
      "line": "ਜਿਨ ਨਰ ਨਾਮ ਤਿਹਾਰੋ ਕਹਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Those persons, who repeated Thy Name,"
    },
    {
      "id": 1665,
      "line": "ਦਾਰਿਦ ਦੁਸਟ ਦੋਖ ਤੇ ਰਹਾ ॥੪੦੦॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "they were saved from poverty and attacks of enemies.400."
    },
    {
      "id": 1666,
      "line": "ਖੜਗ ਕੇਤ ਮੈ ਸਰਣਿ ਤਿਹਾਰੀ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "O Immortal Being (with the sword on Your banner)! I am under Your protection."
    },
    {
      "id": 1667,
      "line": "ਆਪ ਹਾਥ ਦੈ ਲੇਹੁ ਉਬਾਰੀ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Give me Your hand and save me."
    },
    {
      "id": 1668,
      "line": "ਸਰਬ ਠੌਰ ਮੋ ਹੋਹੁ ਸਹਾਈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Stand by me everywhere,"
    },
    {
      "id": 1669,
      "line": "ਦੁਸਟ ਦੋਖ ਤੇ ਲੇਹੁ ਬਚਾਈ ॥੪੦੧॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "and guard me against enmity and pain. 401."
    },
    {
      "id": 1670,
      "line": "ਕ੍ਰਿਪਾ ਕਰੀ ਹਮ ਪਰ ਜਗਮਾਤਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "The Mother of the world has been kind towards me"
    },
    {
      "id": 1671,
      "line": "ਗ੍ਰੰਥ ਕਰਾ ਪੂਰਨ ਸੁਭਰਾਤਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "and I have completed the book this auspicious night"
    },
    {
      "id": 1672,
      "line": "ਕਿਲਬਿਖ ਸਕਲ ਦੇਹ ਕੋ ਹਰਤਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "The Lord is the destroyer of all the sins of the body"
    },
    {
      "id": 1673,
      "line": "ਦੁਸਟ ਦੋਖਿਯਨ ਕੋ ਛੈ ਕਰਤਾ ॥੪੦੨॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "and all the malicious and wicked persons.402."
    },
    {
      "id": 1674,
      "line": "ਸ੍ਰੀ ਅਸਿਧੁਜ ਜਬ ਭਏ ਦਯਾਲਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "When Mahakal became kind,"
    },
    {
      "id": 1675,
      "line": "ਪੂਰਨ ਕਰਾ ਗ੍ਰੰਥ ਤਤਕਾਲਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "he immediately caused me to complete this book"
    },
    {
      "id": 1676,
      "line": "ਮਨ ਬਾਛਤ ਫਲ ਪਾਵੈ ਸੋਈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "He will obtain the fruit desired by the mind (who will read or listen to this book)"
    },
    {
      "id": 1677,
      "line": "ਦੂਖ ਨ ਤਿਸੈ ਬਿਆਪਤ ਕੋਈ ॥੪੦੩॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "and no suffering will occur to him.403."
    },
    {
      "id": 1678,
      "line": "ਅੜਿਲ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "ARRIL"
    },
    {
      "id": 1679,
      "line": "ਸੁਨੈ ਗੁੰਗ ਜੋ ਯਾਹਿ ਸੁ ਰਸਨਾ ਪਾਵਈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "The dumb, who will listen to it, will be blessed with the tongue to speak"
    },
    {
      "id": 1680,
      "line": "ਸੁਨੈ ਮੂੜ ਚਿਤ ਲਾਇ ਚਤੁਰਤਾ ਆਵਈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "The fool, who will listen to it attentively, will get wisdom"
    },
    {
      "id": 1681,
      "line": "ਦੂਖ ਦਰਦ ਭੌ ਨਿਕਟ ਨ ਤਿਨ ਨਰ ਕੇ ਰਹੈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "That person will be absolved of suffering, pain or fear,"
    },
    {
      "id": 1682,
      "line": "ਹੋ ਜੋ ਯਾ ਕੀ ਏਕ ਬਾਰ ਚੌਪਈ ਕੋ ਕਹੈ ॥੪੦੪॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "Who will even once recite this Chaupai-prayer.404."
    },
    {
      "id": 1683,
      "line": "ਚੌਪਈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "CHAUPAI"
    },
    {
      "id": 1684,
      "line": "ਸੰਬਤ ਸਤ੍ਰਹ ਸਹਸ ਭਣਿਜੈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1685,
      "line": "ਅਰਧ ਸਹਸ ਫੁਨਿ ਤੀਨਿ ਕਹਿਜੈ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1686,
      "line": "ਭਾਦ੍ਰਵ ਸੁਦੀ ਅਸਟਮੀ ਰਵਿ ਵਾਰਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": ""
    },
    {
      "id": 1687,
      "line": "ਤੀਰ ਸਤੁਦ੍ਰਵ ਗ੍ਰੰਥ ਸੁਧਾਰਾ ॥੪੦੫॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "It was Bikrami Samvat 1753"
    },
    {
      "id": 1688,
      "line": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਚਾਰ ਸੌ ਪਾਂਚ ਚਰਿਤ੍ਰ ਸਮਾਪਤ ਮਸਤੁ ਸੁਭ ਮਸਤੁ ॥੪੦੫॥੭੫੫੮॥ ਅਫਜੰੂ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "This book was completed on the banks of Sutlej on Sunday, the eighth Sudi of the month of Bhadon."
    },
    {
      "id": 1689,
      "line": "ਸ੍ਵੈਯਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "SWAYYA"
    },
    {
      "id": 1690,
      "line": "ਪਾਇ ਗਹੇ ਜਬ ਤੇ ਤੁਮਰੇ ਤਬ ਤੇ ਕੋਊ ਆਂਖ ਤਰੇ ਨਹੀ ਆਨਯੋ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "O God! the day when I caught hold of your feet, I do not bring anyone else under my sight"
    },
    {
      "id": 1691,
      "line": "ਰਾਮ ਰਹੀਮ ਪੁਰਾਨ ਕੁਰਾਨ ਅਨੇਕ ਕਹੈਂ ਮਤ ਏਕ ਨ ਮਾਨਯੋ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "None other is liked by me now   the Puranas and the Quran try to know Thee by the names of Ram and Rahim and talk about you through several stories,"
    },
    {
      "id": 1692,
      "line": "ਸਿੰਮ੍ਰਿਤਿ ਸਾਸਤ੍ਰ ਬੇਦ ਸਭੈ ਬਹੁ ਭੇਦ ਕਹੈ ਹਮ ਏਕ ਨ ਜਾਨਯੋ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "The Simritis, Shastras and Vedas describe several mysteries of yours, but I do not agree with any of them."
    },
    {
      "id": 1693,
      "line": "ਸ੍ਰੀ ਅਸਿਪਾਨ ਕ੍ਰਿਪਾ ਤੁਮਰੀ ਕਰਿ ਮੈ ਨ ਕਹਯੋ ਸਭ ਤੋਹਿ ਬਖਾਨਯੋ ॥੮੬੩॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "O sword-wielder God! This all has been described by Thy Grace, what power can I have to write all this?.863."
    },
    {
      "id": 1694,
      "line": "ਦੋਹਰਾ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "DOHRA"
    },
    {
      "id": 1695,
      "line": "ਸਗਲ ਦੁਆਰ ਕਉ ਛਾਡਿ ਕੈ ਗਹਯੋ ਤੁਹਾਰੋ ਦੁਆਰ ॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "O Lord! I have forsaken all other doors and have caught hold of only Thy door. O Lord! Thou has caught hold of my arm"
    },
    {
      "id": 1696,
      "line": "ਬਾਹਿ ਗਹੇ ਕੀ ਲਾਜ ਅਸਿ ਗੋਬਿੰਦ ਦਾਸ ਤੁਹਾਰ ॥੮੬੪॥",
      "pauseType": null,
      "bookmarked": false,
      "translation": "I, Govind, am Thy serf, kindly take (care of me and) protect my honour.864."
    }
  ]
}